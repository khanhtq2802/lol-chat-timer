{
	"name": "lol-chat-timer",
	"version": "26.20.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --plugin-search-dir . --check . && eslint .",
		"format": "prettier --plugin-search-dir . --write .",
		"start": "npm run build && node electron/launch.cjs",
		"electron": "node electron/launch.cjs",
		"electron:dev": "node -e \"process.env.OVERLAY_DEV_URL='http://localhost:5173';require('./electron/launch.cjs')\"",
		"update-data": "node electron/update-game-constants.cjs",
		"dist": "npm run build && electron-builder --win",
		"release": "npm run build && electron-builder --win zip",
		"dist:selftest": "vite build --mode selftest && electron-builder --win -c.productName=\"LOL Chat Timer Selftest\" -c.appId=com.lolchattimer.selftest -c.directories.output=dist-selftest"
	},
	"devDependencies": {
		"@nanostores/persistent": "^0.9.1",
		"@sveltejs/adapter-static": "^2.0.3",
		"@sveltejs/kit": "^1.25.2",
		"@tailwindcss/typography": "^0.5.10",
		"@types/node": "^20.8.6",
		"@typescript-eslint/eslint-plugin": "^6.0.0",
		"@typescript-eslint/parser": "^6.0.0",
		"autoprefixer": "^10.4.16",
		"daisyui": "^3.9.2",
		"daisyui-ntsd": "1.0.8",
		"electron": "^39.8.10",
		"electron-builder": "^25.1.8",
		"eslint": "^8.28.0",
		"eslint-config-prettier": "^8.5.0",
		"eslint-plugin-svelte": "^2.30.0",
		"nanostores": "^0.9.4",
		"postcss": "^8.4.31",
		"prettier": "^2.8.0",
		"prettier-plugin-svelte": "^2.10.1",
		"sass": "^1.69.5",
		"svelte": "^4.2.1",
		"svelte-check": "^3.4.3",
		"tailwindcss": "^3.3.3",
		"tslib": "^2.4.1",
		"typescript": "^5.0.0",
		"vite": "^4.4.2"
	},
	"main": "electron/main.cjs",
	"description": "League of Legends overlay to track enemy summoner spell and ultimate cooldowns",
	"author": "khanhtq1",
	"build": {
		"appId": "com.lolchattimer.app",
		"productName": "LOL Chat Timer",
		"directories": {
			"output": "dist",
			"buildResources": "build-resources"
		},
		"files": [
			"package.json",
			"electron/**/*.cjs",
			"!electron/launch.cjs",
			"!electron/update-game-constants.cjs",
			"build/**/*",
			"static/desktop-icon.ico"
		],
		"win": {
			"icon": "static/desktop-icon.ico",
			"signAndEditExecutable": false,
			"artifactName": "LOL-Chat-Timer-${version}-portable.${ext}",
			"target": [
				"dir"
			]
		},
		"asar": false
	}
}
